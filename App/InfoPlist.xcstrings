{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DuoDuo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多多"
          }
        }
      }
    },
    "CFBundleName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DuoDuo Pocket"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DuoDuo Pocket"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DuoDuo Pocket connects to the Passport over Bluetooth to receive button recordings and show replies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多多随身通过蓝牙连接 Passport，接收按键录音并显示回复。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taking a photo to send in the chat and scanning a pairing QR code use the camera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在对话中拍照上传和扫描配对二维码需要使用相机。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The built-in Tailscale node probes the local network to set up direct connections."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置的 Tailscale 节点会探测局域网以建立直连。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only used to tell your own DuoDuo where you have arrived. Off unless you turn it on in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只用来告诉你自己的多多你到了哪里。默认关闭，在设置里打开后才会使用。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you send a location in the chat, your location moves the map to where you are. Also used by Let DuoDuo know where I've arrived in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在对话中发送位置时，用定位把地图移到你所在的地方；也用于设置里的「让多多知道我到了哪」。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold to talk and ambient mode use the microphone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住说话和环境模式需要使用麦克风。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending pictures in the chat needs access to your photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在对话中上传图片需要访问照片。"
          }
        }
      }
    }
  },
  "version": "1.0"
}