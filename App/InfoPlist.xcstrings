{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DuoDuo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多多"
          }
        }
      }
    },
    "CFBundleName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DuoDuo Pocket"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DuoDuo Pocket"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DuoDuo Pocket connects to the Passport over Bluetooth to receive button recordings and show replies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多多随身通过蓝牙连接 Passport，接收按键录音并显示回复。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera takes photos to send in the chat, scans pairing QR codes, and, in ambient mode, lets 多多 see you and the room. The picture goes only to the DuoDuo channel you set up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在对话中拍照、扫描配对二维码，以及在环境模式下让多多看你和房间里的情况，需要使用摄像头。画面只发到你设置的多多频道。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The built-in Tailscale node probes the local network to set up direct connections."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置的 Tailscale 节点会探测局域网以建立直连。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only used to tell your own DuoDuo where you have arrived. Off unless you turn it on in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只用来告诉你自己的多多你到了哪里。默认关闭，在设置里打开后才会使用。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you send a location in the chat, your location moves the map to where you are. Also used by Let DuoDuo know where I've arrived in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在对话中发送位置时，用定位把地图移到你所在的地方；也用于设置里的「让多多知道我到了哪」。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold to talk and ambient mode use the microphone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住说话和环境模式需要使用麦克风。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending pictures in the chat needs access to your photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在对话中上传图片需要访问照片。"
          }
        }
      }
    }
  },
  "version": "1.0"
}